{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insuveo.local/contracts/request-plan.schema.json",
  "title": "RequestPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "objective", "requestType", "respondent", "questions", "method", "limits", "deliverable", "blockingClarifications", "planHash"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "objective": {"type": "string", "minLength": 1},
    "requestType": {"type": "string", "enum": ["initial_collection", "clarification", "renewal_changes"]},
    "respondent": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["contactId", "name", "organization", "email"],
      "properties": {
        "contactId": {"type": "string"},
        "name": {"type": "string"},
        "organization": {"type": "string"},
        "email": {"type": "string", "format": "email"}
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "required", "evidenceRule"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "required": {"type": "boolean"},
          "dataType": {"type": "string"},
          "unitsHint": {"type": ["string", "null"]},
          "periodHint": {"type": ["string", "null"]},
          "evidenceRule": {"type": "string"}
        }
      }
    },
    "alreadyAvailable": {
      "type": "array",
      "items": {"type": "string"}
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "reminderCount"],
      "properties": {
        "channel": {"type": "string", "enum": ["email"]},
        "reminderCount": {"type": "integer", "minimum": 0, "maximum": 2},
        "reminderAfterHours": {"type": "integer", "minimum": 24}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline", "maxTouches", "forbiddenChannels"],
      "properties": {
        "deadline": {"type": "string", "format": "date-time"},
        "maxTouches": {"type": "integer", "minimum": 1, "maximum": 3},
        "forbiddenChannels": {"type": "array", "items": {"type": "string"}}
      }
    },
    "deliverable": {"type": "string"},
    "blockingClarifications": {"type": "array", "items": {"type": "string"}},
    "planHash": {"type": "string", "minLength": 12}
  }
}
